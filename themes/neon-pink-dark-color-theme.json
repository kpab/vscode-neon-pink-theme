{
  "name": "Neon Pink Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#FFE6FF",
    "editorCursor.foreground": "#FF2DBE",
    "editor.lineHighlightBackground": "#33001A",
    "editor.selectionBackground": "#660033",
    "editor.inactiveSelectionBackground": "#33001A",
    "editorLineNumber.foreground": "#FF66CCAA",
    "editorLineNumber.activeForeground": "#FF99E6",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#FFBEE8",
    "sideBar.border": "#1A0010",
    "statusBar.background": "#1A0010",
    "statusBar.foreground": "#FF76D6",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#FF4FB3",
    "tab.activeBackground": "#0A0005",
    "tab.inactiveBackground": "#000000",
    "tab.activeForeground": "#FF89D6",
    "tab.inactiveForeground": "#82456A",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#FF70C8",
    "panel.background": "#000000",
    "panel.border": "#33001A",
    "minimap.background": "#00000000",
    "badge.background": "#FF2DBE",
    "badge.foreground": "#14000C",
    "focusBorder": "#FF2DBE",
    "editorGroup.border": "#33001A",
    "widget.border": "#33001A",

    "list.activeSelectionBackground": "#7A0049",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#4D002E",
    "list.inactiveSelectionForeground": "#FFD6FF",
    "list.hoverBackground": "#2E001C",
    "list.hoverForeground": "#FFD6FF",
    "list.focusBackground": "#66003D",
    "list.focusForeground": "#FFE6FF",
    "list.focusOutline": "#FF2DBE",
    "list.highlightForeground": "#FF66D9",
    "list.errorForeground": "#FF6B8A",
    "list.warningForeground": "#FFB05C",
    "tree.indentGuidesStroke": "#4D002E",

    "input.background": "#14000C",
    "input.foreground": "#FFE6FF",
    "input.border": "#4D002E",
    "input.placeholderForeground": "#C77AAE",
    "inputOption.activeBackground": "#FF2DBE33",
    "inputOption.activeBorder": "#FF2DBE",
    "inputOption.activeForeground": "#FFFFFF",
    "inputValidation.errorBackground": "#4D0018",
    "inputValidation.errorBorder": "#FF6B8A",
    "dropdown.background": "#14000C",
    "dropdown.foreground": "#FFE6FF",
    "dropdown.border": "#4D002E",
    "dropdown.listBackground": "#0A0005",
    "checkbox.background": "#14000C",
    "checkbox.foreground": "#FF66D9",
    "checkbox.border": "#4D002E",

    "button.background": "#FF2DBE",
    "button.foreground": "#14000C",
    "button.hoverBackground": "#FF5AD0",
    "button.secondaryBackground": "#4D002E",
    "button.secondaryForeground": "#FFD6FF",
    "button.secondaryHoverBackground": "#66003D",

    "textLink.foreground": "#FF66D9",
    "textLink.activeForeground": "#FF9AE8"
  },
  "tokenColors": [
    {
      "scope": ["keyword", "storage"],
      "settings": {
        "foreground": "#FF2DBE",
        "fontStyle": ""
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#FF8CF0"
      }
    },
    {
      "scope": ["variable", "parameter"],
      "settings": {
        "foreground": "#FFD6FF"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#FF55C3"
      }
    },
    {
      "scope": ["entity.name.function"],
      "settings": {
        "foreground": "#FF5EC4"
      }
    },
    {
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#FF9AD6"
      }
    },
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#FF66CAA3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["punctuation", "delimiter"],
      "settings": {
        "foreground": "#FFBEE8"
      }
    }
  ]
}
