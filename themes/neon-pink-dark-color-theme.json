  "tokenColors": [
    {
      "scope": ["keyword", "storage"],
      "settings": {
        "foreground": "#FF2DBE",
        "fontStyle": ""
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#FF8CF0"
      }
    },
    {
      "scope": ["variable", "parameter"],
      "settings": {
        "foreground": "#FFD6FF"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#FF55C3"
      }
    },
    {
      "scope": ["entity.name.function"],
      "settings": {
        "foreground": "#FF5EC4"
      }
    },
    {
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#FF9AD6"
      }
    },
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#FF66CAA3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["punctuation", "delimiter"],
      "settings": {
        "foreground": "#FFBEE8"
      }
    }
  ]
}
