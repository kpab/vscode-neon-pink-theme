{
  "name": "neon-pink-dark",
  "displayName": "Neon Pink Dark",
  "description": "A neon-pink dark theme with WCAG-tested modern variants and a lower-contrast Classic snapshot of the original 0.0.1 look.",
  "version": "1.0.0",
  "publisher": "kpab",
  "author": {
    "name": "kpab"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "dark",
    "color-theme",
    "pink",
    "neon",
    "neon pink",
    "cyberpunk",
    "black",
    "magenta",
    "futuristic",
    "synthwave",
    "retro",
    "night",
    "aesthetic",
    "colorful",
    "vibrant",
    "high contrast"
  ],
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kpab/vscode-neon-pink-theme.git"
  },
  "bugs": {
    "url": "https://github.com/kpab/vscode-neon-pink-theme/issues"
  },
  "homepage": "https://github.com/kpab/vscode-neon-pink-theme#readme",
  "qna": "marketplace",
  "contributes": {
    "themes": [
      {
        "label": "Neon Pink Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/neon-pink-dark-color-theme.json"
      },
      {
        "label": "Neon Pink Dark Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/neon-pink-dark-soft-color-theme.json"
      },
      {
        "label": "Neon Pink Dimmed",
        "uiTheme": "vs-dark",
        "path": "./themes/neon-pink-dimmed-color-theme.json"
      },
      {
        "label": "Neon Pink Dark Classic",
        "uiTheme": "vs-dark",
        "path": "./themes/neon-pink-dark-classic-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-themes.js",
    "icon": "node scripts/generate-icon.js",
    "validate": "node scripts/validate-themes.js",
    "extract-color-keys": "node scripts/extract-color-keys.js",
    "test": "node scripts/validate-themes.js && node scripts/build-themes.js --check && node scripts/check-contrast.js"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
